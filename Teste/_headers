/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data:; frame-src https:; connect-src 'self' https://api.vegitoons.black; base-uri 'none'; form-action 'self'; object-src 'none'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/imagens/*
  Cache-Control: public, max-age=604800

/*.js
  Cache-Control: no-cache

/*.css
  Cache-Control: no-cache

/*.html
  Cache-Control: no-cache
